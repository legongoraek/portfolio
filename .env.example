# Chat bot (Anthropic Claude) — /api/chat
# Clave de API de Anthropic (https://console.anthropic.com/). Nunca la subas al repo.
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto un modelo económico/rápido alcanza para un FAQ bot.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Orígenes permitidos para llamar a /api/chat desde otros sitios (separados por coma).
# Incluye el portafolio estático (legongoraek.github.io) porque también consume este endpoint.
CHAT_ALLOWED_ORIGINS=https://luisenriquegongoraek.com,https://legongoraek.github.io,http://localhost:4321
