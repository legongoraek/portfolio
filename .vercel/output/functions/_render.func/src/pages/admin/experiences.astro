---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import experiencesData from '../../data/experiences.json';

export const prerender = false;

const experiences = experiencesData;
const isAuthenticated = Astro.cookies.get('admin_auth')?.value === '1';

if (!isAuthenticated) {
  return Astro.redirect('/admin/login?redirect=%2Fadmin%2Fexperiences');
}
---

<Layout title="Admin - Experiencias" showChrome={false}>
  <main class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="mb-12">
        <div class="flex items-center justify-between gap-4 mb-6">
          <a href="/" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700">
            <Icon name="mdi:arrow-left" class="w-5 h-5" />
            Volver al inicio
          </a>

          <a href="/admin/logout" class="inline-flex items-center gap-2 text-red-600 hover:text-red-700 font-semibold">
            <Icon name="mdi:logout" class="w-5 h-5" />
            Cerrar sesion
          </a>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2 mt-8">Gestionar Experiencias</h1>
        <p class="text-gray-600">Agrega, edita o elimina experiencias de tu portafolio</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        {/* Form */}
        <div class="lg:col-span-1">
          <div class="sticky top-8 p-8 rounded-2xl bg-white shadow-lg border border-gray-200">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Agregar Experiencia</h3>
            
            <form id="experienceForm" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Puesto/Rol</label>
                <input
                  type="text"
                  name="role"
                  placeholder="Desarrollador Full Stack"
                  required
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Empresa</label>
                <input
                  type="text"
                  name="company"
                  placeholder="Nombre de la empresa"
                  required
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Período</label>
                <input
                  type="text"
                  name="period"
                  placeholder="Enero 2024 - Actualidad"
                  required
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Logros</label>
                <textarea
                  name="achievements"
                  placeholder="Logro 1, Logro 2 (separados por coma)"
                  rows="3"
                  required
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                ></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Impacto</label>
                <textarea
                  name="impact"
                  placeholder="Impacto 1, Impacto 2 (separados por coma)"
                  rows="3"
                  required
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                ></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Icon (MDI)</label>
                <input
                  type="text"
                  name="icon"
                  placeholder="mdi:code-braces-box"
                  required
                  class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>

              <button
                type="submit"
                class="w-full px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-400 text-white font-semibold rounded-lg hover:shadow-lg transition-all duration-300"
              >
                Agregar Experiencia
              </button>
            </form>

            <div id="formMessage" class="mt-4 p-4 rounded-lg hidden text-sm"></div>
          </div>
        </div>

        {/* List */}
        <div class="lg:col-span-2">
          <div class="space-y-4">
            <h3 class="text-sm font-bold text-gray-900 mb-6">Experiencias Actuales ({experiences.length})</h3>
            
            {experiences.length === 0 ? (
              <div class="p-8 rounded-2xl bg-white border-2 border-dashed border-gray-300 text-center">
                <p class="text-gray-600">No hay experiencias aún</p>
              </div>
            ) : (
              <div class="space-y-4">
                {experiences.map((exp, index) => (
                  <div class="p-6 rounded-2xl bg-white shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                    <div class="flex items-start justify-between gap-4">
                      <div class="flex-1">
                        <h3 class="text-lg font-bold text-gray-900">{exp.role}</h3>
                        <p class="text-sm text-blue-600 font-semibold mt-1">{exp.company}</p>
                        <p class="text-xs text-gray-600 mt-1">{exp.period}</p>
                        
                        <div class="mt-4 space-y-2">
                          <div>
                            <p class="text-xs font-semibold text-gray-700 uppercase">Logros:</p>
                            <ul class="text-sm text-gray-600 mt-1 space-y-1">
                              {exp.achievements.map((a) => (
                                <li>• {a}</li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      </div>

                      <button
                        type="button"
                        onclick={`deleteExperience('${exp.role}', '${exp.company}')`}
                        class="px-4 py-2 rounded-lg bg-red-100 text-red-600 hover:bg-red-200 font-semibold transition-colors shrink-0"
                      >
                        <Icon name="mdi:delete" class="w-5 h-5 inline-block" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('experienceForm') as HTMLFormElement | null;
  const messageDiv = document.getElementById('formMessage') as HTMLDivElement | null;

  const toText = (value: FormDataEntryValue | null) => (typeof value === 'string' ? value.trim() : '');

  const showMessage = (message: string, isError = false) => {
    if (!messageDiv) return;
    messageDiv.textContent = message;
    messageDiv.className = isError
      ? 'mt-4 p-4 rounded-lg bg-red-100 text-red-700 border border-red-300'
      : 'mt-4 p-4 rounded-lg bg-green-100 text-green-700 border border-green-300';
    messageDiv.classList.remove('hidden');
  };

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        role: toText(formData.get('role')),
        company: toText(formData.get('company')),
        period: toText(formData.get('period')),
        achievements: toText(formData.get('achievements')).split(',').map((a) => a.trim()).filter(Boolean),
        impact: toText(formData.get('impact')).split(',').map((i) => i.trim()).filter(Boolean),
        icon: toText(formData.get('icon')),
      };

      if (!data.role || !data.company || !data.period) {
        showMessage('❌ Completa rol, empresa y período.', true);
        return;
      }

      try {
        const response = await fetch('/api/experiences', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          showMessage('✅ Experiencia agregada exitosamente');
          form.reset();
          setTimeout(() => window.location.reload(), 1500);
        } else {
          let errorMessage = 'Error al agregar la experiencia';
          try {
            const payload = await response.json();
            if (payload?.error) errorMessage = payload.error;
          } catch {
            // Ignore JSON parsing error and keep default message.
          }
          throw new Error(errorMessage);
        }
      } catch (error) {
        showMessage('❌ ' + (error instanceof Error ? error.message : 'Error desconocido'), true);
      }
    });
  }

  (window as any).deleteExperience = async (role: string, company: string) => {
    if (!confirm(`¿Seguro que deseas eliminar "${role}" en "${company}"?`)) return;

    try {
      const response = await fetch('/api/experiences', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role, company }),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        let errorMessage = 'Error al eliminar la experiencia';
        try {
          const payload = await response.json();
          if (payload?.error) errorMessage = payload.error;
        } catch {
          // Ignore JSON parsing error and keep default message.
        }
        alert(errorMessage);
      }
    } catch (error) {
      alert('Error: ' + (error instanceof Error ? error.message : 'Error desconocido'));
    }
  };
</script>
