// En /en/ cada proyecto sustituye sus textos por los de `en`; lo que no traduce se queda igual.
const isEn = Astro.currentLocale === 'en';
const items = projects.map((project) => (isEn ? { ...project, ...project.en } : project));

const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section id="proyectos" class="section">
  <div class="container-custom">
    <SectionHeader
      anchor={isEn ? 'projects' : 'proyectos'}
      title={isEn ? 'Featured' : 'Proyectos'}
      accent={isEn ? 'projects' : 'destacados'}
      lead={isEn
        ? 'Digital products, platforms and applications built with a focus on scalability, performance and user experience.'
        : 'Productos digitales, plataformas y aplicaciones desarrolladas con enfoque en escalabilidad, rendimiento y experiencia de usuario.'}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-5">
      {items.map((project, index) => (
        <article
          class="reveal panel panel-hover group relative flex flex-col p-6 md:p-7"
          style={`--reveal-delay:${(index % 3) * 70}ms`}
        >
          <div class="flex items-start justify-between gap-4 mb-5">
            <span class="grid place-items-center w-12 h-12 rounded-xl bg-accent-soft text-accent transition-transform duration-300 group-hover:-rotate-6">
              <Icon name={project.icon} class="w-6 h-6" />
            </span>
            <span class="font-mono text-xs font-medium text-muted border border-line rounded-md px-2 py-1">
              {project.category}
            </span>
          </div>

          <h3 class="text-xl md:text-[1.35rem] font-bold leading-snug mb-3">
            {project.title}
          </h3>

          <p class="text-muted leading-relaxed text-[0.95rem] mb-5">
            {project.description}
          </p>

          <ul class="space-y-2 mb-6 flex-1" aria-label={isEn ? 'Impact' : 'Impacto'}>
            {project.impact.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-ink/85">
                <Icon name="mdi:check" class="w-4 h-4 mt-0.5 text-ok shrink-0" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <ul class="flex flex-wrap gap-1.5 mb-6" aria-label={isEn ? 'Technologies' : 'Tecnologías'}>
            {project.technologies.map((tech) => (
              <li class="font-mono text-[0.72rem] font-medium px-2 py-1 rounded-md bg-surface-2 border border-line text-ink/75">
                {tech}
              </li>
            ))}
          </ul>

          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link flex items-center justify-between gap-3 pt-4 border-t border-line text-sm"
            >
              <span class="font-mono text-muted truncate">{hostOf(project.link)}</span>
              <span class="inline-flex items-center gap-1.5 font-bold text-accent shrink-0">
                {isEn ? 'View project' : 'Ver proyecto'}
                <Icon name="mdi:arrow-top-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Toda la tarjeta es clicable sin anidar enlaces: el ::after del enlace la cubre. */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
</style>
