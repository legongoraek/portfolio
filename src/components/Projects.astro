---

<section
  id="proyectos"
  class="relative overflow-hidden pt-16 md:pt-24 pb-16 md:pb-24 isolate
  bg-white"
>

  {/* Glow Background */}
  <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-primary-400/10 rounded-full blur-3xl opacity-30 -z-10"></div>

  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-blue-300/10 rounded-full blur-3xl opacity-30 -z-10"></div>

  {/* Grid */}
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none -z-10">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#64748b_1px,transparent_1px),linear-gradient(to_bottom,#64748b_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {/* HEADER */}
    <div class="text-center mb-10 md:mb-20">

      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6
      bg-white/70
      border border-white/20
      backdrop-blur-xl shadow-lg shadow-black/5">

        <div class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></div>

        <span class="text-sm font-medium text-gray-700">
          Casos reales y productos digitales
        </span>

      </div>

      <h2 class="text-5xl md:text-6xl font-black tracking-tight mb-6 text-blue-600">

        Proyectos Destacados

      </h2>

      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Productos digitales, plataformas y aplicaciones
        desarrolladas con enfoque en escalabilidad,
        rendimiento y experiencia de usuario.
      </p>

    </div>

    {/* PROJECTS GRID */}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 md:gap-8">

      {projects.map((project, index) => (

        <div
          class="project-card group"
          style={`animation-delay:${index * 0.1}s`}
        >

          {/* Glow */}
          <div class="project-glow"></div>

          <div class="relative z-10 flex flex-col h-full">

            {/* TOP */}
            <div class="flex items-start justify-between mb-6">

              <div>

                <span class="project-badge">
                  {project.category}
                </span>

                <h3 class="project-title mt-4">
                  {project.title}
                </h3>

              </div>

              <div class="project-icon">
                <Icon
                  name={project.icon}
                  class="w-8 h-8"
                />
              </div>

            </div>

            {/* DESCRIPTION */}
            <p class="project-description">
              {project.description}
            </p>

            {/* TECH */}
            <div class="mt-8">

              <p class="project-label">
                Tecnologías
              </p>

              <div class="flex flex-wrap gap-2 mt-3">

                {project.technologies.map((tech) => (
                  <span class="tech-pill">
                    {tech}
                  </span>
                ))}

              </div>

            </div>

            {/* IMPACT */}
            <div class="mt-8 flex-1">

              <p class="project-label">
                Impacto
              </p>

              <ul class="space-y-3 mt-4">

                {project.impact.map((item) => (
                  <li class="project-impact">

                    <div class="impact-icon">
                      <Icon
                        name="mdi:check"
                        class="w-3 h-3"
                      />
                    </div>

                    <span>{item}</span>

                  </li>
                ))}

              </ul>

            </div>

            {/* LINK */}
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link mt-10"
              >

                <span>Ver proyecto</span>

                <svg
                  class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"
                  ></path>
                </svg>

              </a>
            )}

          </div>

        </div>

      ))}

    </div>

  </div>
</section>

<style>
  .project-card {
    position: relative;

    padding: 2rem;

    border-radius: 2rem;

    background: rgba(255,255,255,0.72);

    backdrop-filter: blur(16px);

    border: 1px solid rgba(255,255,255,0.4);

    box-shadow:
      0 10px 30px rgba(0,0,0,0.05);

    overflow: hidden;

    transition:
      transform 300ms ease,
      box-shadow 300ms ease,
      border-color 300ms ease;

    animation: fadeUp 0.7s ease forwards;

    opacity: 0;
  }

  .project-card:hover {
    transform: translateY(-10px);

    box-shadow:
      0 30px 60px rgba(0,0,0,0.08);

    border-color: rgba(59,130,246,0.25);
  }

  .project-glow {
    position: absolute;
    inset: 0;

    background: transparent;

    opacity: 0;

    transition: opacity 300ms ease;
  }

  .group:hover .project-glow {
    opacity: 1;
  }

  .project-badge {
    display: inline-flex;
    align-items: center;

    padding: 0.45rem 0.9rem;

    border-radius: 999px;

    background: rgba(0,87,184,0.12);

    color: #0057B8;

    font-size: 0.75rem;
    font-weight: 700;

    border: 1px solid rgba(59,130,246,0.15);
  }

  .project-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
  }

  .project-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 1rem;
    background: rgba(59,130,246,0.08);
    color: #0057B8;
  }

  .project-description {
    color: #475569;
    line-height: 1.7;
  }

  .project-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: #64748b;
  }

  .tech-pill {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .project-impact {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    color: #334155;
  }

  .impact-icon {
    flex: 0 0 auto;
    margin-top: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34,197,94,0.1);
    color: #16a34a;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #0057B8;
    font-weight: 800;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
