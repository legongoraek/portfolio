---

import { Icon } from "astro-icon/components";

const technologies = {
  frontend: [
    { name: 'React', icon: 'logos:react' },
    { name: 'Vue.js', icon: 'logos:vue' },
    { name: 'React Native', icon: 'logos:react' },
    { name: 'Next.js', icon: 'logos:nextjs-icon' },
    { name: 'Electron', icon: 'logos:electron' },
    { name: 'JavaScript', icon: 'logos:javascript' },
  ],
  backend: [
    { name: 'Django', icon: 'logos:django-icon' },
    { name: 'Django REST', icon: 'mdi:api' },
    { name: 'Node.js', icon: 'logos:nodejs-icon' },
    { name: 'Python', icon: 'logos:python' },
    { name: 'JWT Auth', icon: 'mdi:key-chain' },
    { name: '.NET', icon: 'logos:dotnet' },
  ],
  database: [
    { name: 'PostgreSQL', icon: 'logos:postgresql' },
    { name: 'MySQL', icon: 'logos:mysql' },
    { name: 'SQL', icon: 'mdi:database' },
    { name: 'Azure', icon: 'logos:microsoft-azure' },
  ],
  tools: [
    { name: 'WordPress', icon: 'logos:wordpress-icon' },
    { name: 'WooCommerce', icon: 'logos:woocommerce-icon' },
    { name: 'Linux/Ubuntu', icon: 'logos:ubuntu' },
    { name: 'API Integration', icon: 'mdi:api' },
    { name: 'Automatización', icon: 'mdi:robot-outline' },
  ],
};
---



<section
  id="stack"
  class="relative overflow-hidden py-24 isolate
  bg-[linear-gradient(to_bottom,#ffffff,#f8fbff,#eef5ff)]"
>

  {/* Glow Background */}
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-400/10 rounded-full blur-3xl opacity-30 -z-10"></div>

  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-300/10 rounded-full blur-3xl opacity-30 -z-10"></div>

  {/* Grid */}
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none -z-10">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#64748b_1px,transparent_1px),linear-gradient(to_bottom,#64748b_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {/* Header */}
    <div class="text-center mb-20">

      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6
      bg-white/70
      border border-white/20
      backdrop-blur-xl shadow-lg shadow-black/5">

        <div class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></div>

        <span class="text-sm font-medium text-gray-700">
          Tecnologías modernas
        </span>
      </div>

      <h2 class="text-5xl md:text-6xl font-black tracking-tight mb-6">

        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-400">
          Stack Tecnológico
        </span>

      </h2>

      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Tecnologías y herramientas modernas que utilizo para construir
        productos digitales rápidos, escalables y enfocados en negocio.
      </p>

    </div>

    {/* Cards */}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">

      {/* FRONTEND */}
      <div class="tech-card group">
        <div class="tech-glow"></div>

        <div class="relative z-10">

          <div class="tech-icon-wrapper">
            💻
          </div>

          <h3 class="tech-title">
            Frontend
          </h3>

          <ul class="space-y-4 mt-8">
            {technologies.frontend.map((tech) => (
              <li class="tech-item">
                <Icon name={tech.icon} class="text-2xl" />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>

        </div>
      </div>

      {/* BACKEND */}
      <div class="tech-card group">
        <div class="tech-glow"></div>

        <div class="relative z-10">

          <div class="tech-icon-wrapper">
            ⚙️
          </div>

          <h3 class="tech-title">
            Backend
          </h3>

          <ul class="space-y-4 mt-8">
            {technologies.backend.map((tech) => (
              <li class="tech-item">
                <Icon name={tech.icon} class="text-2xl" />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>

        </div>
      </div>

      {/* DATABASE */}
      <div class="tech-card group">
        <div class="tech-glow"></div>

        <div class="relative z-10">

          <div class="tech-icon-wrapper">
            🗄️
          </div>

          <h3 class="tech-title">
            Datos
          </h3>

          <ul class="space-y-4 mt-8">
            {technologies.database.map((tech) => (
              <li class="tech-item">
                <Icon name={tech.icon} class="text-2xl" />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>

        </div>
      </div>

      {/* TOOLS */}
      <div class="tech-card group">
        <div class="tech-glow"></div>

        <div class="relative z-10">

          <div class="tech-icon-wrapper">
            🚀
          </div>

          <h3 class="tech-title">
            Herramientas
          </h3>

          <ul class="space-y-4 mt-8">
            {technologies.tools.map((tech) => (
              <li class="tech-item">
                <Icon name={tech.icon} class="text-2xl" />
                <span>{tech.name}</span>
              </li>
            ))}
          </ul>

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .tech-card {
    position: relative;

    padding: 2rem;

    border-radius: 2rem;

    background: rgba(255,255,255,0.7);

    backdrop-filter: blur(16px);

    border: 1px solid rgba(255,255,255,0.3);

    box-shadow:
      0 10px 30px rgba(0,0,0,0.05);

    overflow: hidden;

    transition:
      transform 300ms ease,
      box-shadow 300ms ease,
      border-color 300ms ease;
  }

  .tech-card:hover {
    transform: translateY(-8px);

    box-shadow:
      0 25px 50px rgba(0,0,0,0.08);

    border-color: rgba(59,130,246,0.25);
  }

  .tech-glow {
    position: absolute;
    inset: 0;

    background:
      radial-gradient(circle at top right,
      rgba(59,130,246,0.15),
      transparent 45%);

    opacity: 0;

    transition: opacity 300ms ease;
  }

  .group:hover .tech-glow {
    opacity: 1;
  }

  .tech-icon-wrapper {
    width: 4rem;
    height: 4rem;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 1.2rem;

    background:
      linear-gradient(
        135deg,
        rgba(0,87,184,0.12),
        rgba(59,130,246,0.08)
      );

    font-size: 1.8rem;

    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.4);
  }

  .tech-title {
    margin-top: 1.5rem;

    font-size: 1.5rem;
    font-weight: 800;

    color: #0f172a;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 1rem;

    padding: 0.85rem 1rem;

    border-radius: 1rem;

    background: rgba(255,255,255,0.45);

    border: 1px solid rgba(255,255,255,0.2);

    color: rgb(51, 65, 85);

    font-weight: 500;

    transition:
      transform 220ms ease,
      background 220ms ease,
      border-color 220ms ease;
  }

  .tech-item:hover {
    transform: translateX(4px);

    background: rgba(255,255,255,0.75);

    border-color: rgba(59,130,246,0.2);

    color: #0057B8;
  }
</style>