---

import { Icon } from "astro-icon/components";
import SectionHeader from "./SectionHeader.astro";

const technologies = {
  frontend: [
    { name: 'React', icon: 'logos:react' },
    { name: 'Vue.js', icon: 'logos:vue' },
    { name: 'React Native', icon: 'logos:react' },
    { name: 'Next.js', icon: 'logos:nextjs-icon' },
    { name: 'Electron', icon: 'logos:electron' },
    { name: 'JavaScript', icon: 'logos:javascript' },
  ],
  backend: [
    { name: 'Django', icon: 'logos:django-icon' },
    { name: 'Django REST', icon: 'mdi:api' },
    { name: 'Node.js', icon: 'logos:nodejs-icon' },
    { name: 'Python', icon: 'logos:python' },
    { name: 'JWT Auth', icon: 'mdi:key-chain' },
    { name: '.NET', icon: 'logos:dotnet' },
  ],
  database: [
    { name: 'PostgreSQL', icon: 'logos:postgresql' },
    { name: 'MySQL', icon: 'logos:mysql' },
    { name: 'SQL', icon: 'mdi:database' },
    { name: 'Azure', icon: 'logos:microsoft-azure' },
    { name: 'SQLite', icon: 'logos:sqlite' },
  ],
  tools: [
    { name: 'WordPress', icon: 'logos:wordpress-icon' },
    { name: 'Linux/Ubuntu', icon: 'logos:ubuntu' },
    { name: 'API Integration', icon: 'mdi:api' },
    { name: 'Automatización', icon: 'mdi:robot-outline' },
    { name: 'Git/GitHub', icon: 'logos:github-icon' },
    { name: 'Docker', icon: 'logos:docker-icon' },
  ],
};

const groups = [
  { title: 'Frontend', icon: 'mdi:monitor-dashboard', items: technologies.frontend },
  { title: 'Backend', icon: 'mdi:server-outline', items: technologies.backend },
  { title: 'Datos', icon: 'mdi:database-outline', items: technologies.database },
  { title: 'Herramientas', icon: 'mdi:tools', items: technologies.tools },
];
---

<section id="stack" class="section">
  <div class="container-custom">
    <SectionHeader
      anchor="stack"
      title="Stack"
      accent="tecnológico"
      lead="Tecnologías y herramientas que utilizo para construir productos digitales rápidos, escalables y enfocados en negocio."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-5">
      {groups.map((group, i) => (
        <div class="reveal panel panel-hover p-6" style={`--reveal-delay:${i * 80}ms`}>
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold">{group.title}</h3>
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-accent-soft text-accent">
              <Icon name={group.icon} class="w-5 h-5" />
            </span>
          </div>

          <ul class="divide-y divide-line">
            {group.items.map((tech) => (
              <li class="tech-item flex items-center gap-3 py-2.5 text-[0.95rem] font-semibold text-ink/80">
                <span class="grid place-items-center w-8 h-8 rounded-lg bg-white border border-line shrink-0 text-[#14213d]">
                  <Icon name={tech.icon} class="w-[1.15rem] h-[1.15rem]" />
                </span>
                {tech.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-item {
    transition: color 200ms ease, transform 200ms ease;
  }

  .tech-item:hover {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
