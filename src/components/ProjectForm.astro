---
// src/components/ProjectForm.astro
// Este componente necesita ser interactivo, así que se renderiza como un cliente
---

<div id="project-form-container" class="mt-12 p-8 rounded-2xl bg-white/50 backdrop-blur-xl border border-white/30 shadow-lg">
  <h3 class="text-2xl font-bold text-gray-900 mb-6">Agregar Nuevo Proyecto</h3>
  
  <form id="projectForm" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input
        type="text"
        name="title"
        placeholder="Título del proyecto"
        required
        class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      
      <input
        type="text"
        name="category"
        placeholder="Categoría (ej: Full Stack, Frontend, etc)"
        required
        class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <textarea
      name="description"
      placeholder="Descripción del proyecto"
      rows="3"
      required
      class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
    ></textarea>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input
        type="url"
        name="link"
        placeholder="Link del proyecto"
        required
        class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      
      <input
        type="text"
        name="icon"
        placeholder="Icon (ej: mdi:web)"
        required
        class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Tecnologías (separadas por comas)</label>
      <input
        type="text"
        name="technologies"
        placeholder="React, Next.js, Tailwind CSS"
        required
        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Impacto (separado por comas)</label>
      <input
        type="text"
        name="impact"
        placeholder="SEO optimizado, Performance excelente"
        required
        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <button
      type="submit"
      class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all duration-300"
    >
      Agregar Proyecto
    </button>
  </form>

  <div id="formMessage" class="mt-4 p-4 rounded-lg hidden"></div>
</div>

<script>
  const form = document.getElementById('projectForm');
  const messageDiv = document.getElementById('formMessage');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        title: formData.get('title'),
        description: formData.get('description'),
        technologies: formData.get('technologies').split(',').map(t => t.trim()),
        impact: formData.get('impact').split(',').map(i => i.trim()),
        link: formData.get('link'),
        category: formData.get('category'),
        icon: formData.get('icon'),
      };

      try {
        const response = await fetch('/api/projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          messageDiv.textContent = '✅ Proyecto agregado exitosamente';
          messageDiv.className = 'mt-4 p-4 rounded-lg bg-green-100 text-green-700 border border-green-300';
          form.reset();
          
          // Recargar la página después de 2 segundos para mostrar el nuevo proyecto
          setTimeout(() => window.location.reload(), 2000);
        } else {
          throw new Error('Error al agregar el proyecto');
        }
      } catch (error) {
        messageDiv.textContent = '❌ ' + error.message;
        messageDiv.className = 'mt-4 p-4 rounded-lg bg-red-100 text-red-700 border border-red-300';
      }

      messageDiv.classList.remove('hidden');
    });
  }
</script>
