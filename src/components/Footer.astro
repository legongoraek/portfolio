---
import { Icon } from 'astro-icon/components';
import versionData from '../../version.json';

const currentYear = new Date().getFullYear();
const version = versionData.version;
const releaseDate = new Date(versionData.releaseDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const links = [
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Contacto', href: '#contacto' },
];

const socials = [
  { label: 'GitHub', href: 'https://github.com/legongoraek', icon: 'mdi:github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/luisenriquegongoraek', icon: 'mdi:linkedin' },
  { label: 'WhatsApp', href: 'https://wa.me/529994231687', icon: 'mdi:whatsapp' },
  { label: 'Portafolio', href: 'https://legongoraek.github.io', icon: 'mdi:link-variant' },
];
---

<footer class="border-t border-line mt-8">
  <div class="container-custom py-12 md:py-14">
    <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr_1fr] gap-10">
      <div>
        <p class="font-display text-lg font-bold text-ink mb-3">Luis Enrique Góngora Ek</p>
        <p class="text-sm text-muted leading-relaxed max-w-sm">
          Full Stack Developer especializado en web, mobile y automatización de procesos.
        </p>
      </div>

      <nav aria-label="Enlaces del pie">
        <p class="eyebrow mb-4">enlaces</p>
        <ul class="space-y-2 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.href} class="font-semibold text-muted hover:text-accent transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="eyebrow mb-4">conecta conmigo</p>
        <div class="flex gap-2">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="grid place-items-center w-10 h-10 rounded-xl border border-line text-muted hover:text-accent hover:border-accent transition-colors"
            >
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-line flex flex-col md:flex-row gap-2 justify-between text-center md:text-left">
      <p class="text-sm text-muted">&copy; {currentYear} Luis Enrique Góngora Ek. Todos los derechos reservados.</p>
      <p class="font-mono text-xs text-muted">v{version} · deploy {releaseDate}</p>
    </div>
  </div>
</footer>
