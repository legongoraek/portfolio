---
import { Icon } from 'astro-icon/components';

const navItems = [
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Stack', href: '#stack' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Contacto', href: '#contacto' },
];
---

<nav class="fixed top-3 md:top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-1.5rem)] max-w-6xl" aria-label="Principal">
  <div
    id="nav-panel"
    class="rounded-2xl border border-line bg-surface/85 backdrop-blur-xl shadow-[var(--shadow)] transition-shadow duration-300"
  >
    <div class="px-4 lg:px-6">
      <div class="flex items-center justify-between h-16">
        <a href="#sobre-mi" class="flex items-center gap-3 shrink-0" aria-label="Luis Enrique Góngora Ek, ir al inicio">
          <span class="grid place-items-center w-9 h-9 rounded-xl bg-accent text-on-accent font-display font-bold text-sm tracking-tight">
            LE
          </span>
          <span class="leading-tight">
            <span class="block font-display font-bold text-ink text-sm md:text-base">Luis Enrique</span>
            <span class="block font-mono text-[0.7rem] text-muted">full stack dev</span>
          </span>
        </a>

        <div class="hidden md:flex items-center gap-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              data-nav-link
              class="px-3.5 py-2 rounded-lg text-sm font-semibold text-muted hover:text-ink hover:bg-accent-soft transition-colors aria-[current=true]:text-accent aria-[current=true]:bg-accent-soft"
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <button
            id="theme-toggle"
            type="button"
            class="grid place-items-center w-10 h-10 rounded-xl border border-line text-muted hover:text-ink hover:border-accent transition-colors cursor-pointer"
            aria-label="Cambiar tema claro u oscuro"
          >
            <Icon name="mdi:weather-night" class="w-5 h-5 dark:hidden" />
            <Icon name="mdi:white-balance-sunny" class="w-5 h-5 hidden dark:block" />
          </button>

          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden grid place-items-center w-10 h-10 rounded-xl border border-line text-ink cursor-pointer"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <Icon name="mdi:menu" class="w-5 h-5" />
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden pb-4 pt-1 border-t border-line">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="block px-3 py-3 rounded-lg font-semibold text-muted hover:text-ink hover:bg-accent-soft aria-[current=true]:text-accent"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  function setMenuOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    menuBtn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  menuBtn?.addEventListener('click', () => setMenuOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  // Marca el enlace de la sección que ocupa el centro de la pantalla.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const hash = `#${entry.target.id}`;
        links.forEach((link) => link.setAttribute('aria-current', String(link.hash === hash)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );

  document.querySelectorAll('#sobre-mi, #stack, #proyectos, #experiencia, #contacto').forEach((s) => sectionObserver.observe(s));
</script>
