---
import { Icon } from 'astro-icon/components';

const contactInfo = [
  {
    title: 'Email',
    value: 'enriquegongora45@gmail.com',
    href: 'mailto:enriquegongora45@gmail.com',
    icon: 'mdi:email-outline',
    color: 'from-blue-500 to-primary-600',
  },
  {
    title: 'WhatsApp',
    value: '+52 999 423 1687',
    href: 'https://wa.me/529994231687',
    icon: 'mdi:whatsapp',
    color: 'from-emerald-500 to-green-600',
  },
  {
    title: 'LinkedIn',
    value: 'luisenriquegongoraek',
    href: 'https://www.linkedin.com/in/luisenriquegongoraek',
    icon: 'mdi:linkedin',
    color: 'from-sky-500 to-blue-700',
  },
  {
    title: 'GitHub',
    value: 'legongoraek',
    href: 'https://github.com/legongoraek',
    icon: 'mdi:github',
    color: 'from-blue-500 to-primary-600',
  },
];
---

<section
  id="contacto"
  class="relative overflow-hidden py-20 md:py-28 isolate
  bg-white"
>

  {/* Glow Effects */}
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-300/20 rounded-full blur-3xl opacity-30 -z-10"></div>

  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-300/20 rounded-full blur-3xl opacity-30 -z-10"></div>

  {/* Grid Pattern */}
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none">
    <div class="absolute inset-0
    bg-[linear-gradient(to_right,#64748b_1px,transparent_1px),linear-gradient(to_bottom,#64748b_1px,transparent_1px)]
    bg-[size:64px_64px]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {/* Header */}
    <div class="text-center mb-20">

      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6
      bg-white/70 border border-white/30 backdrop-blur-xl shadow-lg shadow-black/5">

        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>

        <div class="flex items-center gap-2">
          <Icon
            name="mdi:check-decagram"
            class="w-4 h-4 text-emerald-500"
          />

          <span class="text-sm font-medium text-gray-700">
            Disponible para nuevos proyectos
          </span>
        </div>

      </div>

      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.3] mb-6">

        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-400">
          ¿Trabajamos
        </span>

        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-400">
          juntos?
        </span>

      </h2>

      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Desarrollo soluciones web y móviles enfocadas en rendimiento,
        escalabilidad y crecimiento digital.
      </p>

    </div>

    {/* Contact Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">

      {contactInfo.map((item, index) => (
        <a
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : '_self'}
          rel={item.href.startsWith('http') ? 'noopener noreferrer' : ''}
          class="group relative overflow-hidden rounded-[2rem]
          bg-white/70 backdrop-blur-xl
          border border-white/30
          shadow-[0_20px_60px_rgba(0,0,0,0.06)]
          hover:shadow-[0_25px_80px_rgba(0,87,184,0.12)]
          transition-all duration-500
          hover:-translate-y-1"
          style={`animation-delay:${index * 0.1}s`}
        >

          {/* Hover Glow */}
          <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500
          bg-gradient-to-br ${item.color} /[0.05]`}>
          </div>

          <div class="relative z-10 p-7">

            {/* Icon */}
            <div
              class={`w-16 h-16 rounded-2xl mb-6
              bg-gradient-to-br ${item.color}
              flex items-center justify-center
              text-3xl text-white
              shadow-lg`}
            >
              <Icon
                name={item.icon}
                class="w-8 h-8"
              />
            </div>

            {/* Content */}
            <p class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-2">
              {item.title}
            </p>

            <p class="text-lg font-bold text-slate-900 break-all group-hover:text-primary-700 transition-colors">
              {item.value}
            </p>

          </div>

        </a>
      ))}

    </div>

    {/* CTA Card */}
    <div
      class="relative overflow-hidden rounded-[2.5rem]
      bg-white/70 backdrop-blur-xl
      border border-white/30
      shadow-[0_25px_80px_rgba(0,0,0,0.08)]"
    >

      {/* Background Glow */}
      <div class="absolute inset-0 bg-gradient-to-br from-primary-500/[0.04] via-transparent to-blue-500/[0.05]"></div>

      <div class="relative z-10 px-8 py-14 md:px-16 text-center">

        <div
          class="inline-flex items-center justify-center
          w-20 h-20 rounded-[1.5rem]
          bg-gradient-to-br from-primary-600 to-blue-500
          text-white
          shadow-xl shadow-primary-500/20 mb-8"
        >
          <Icon
            name="mdi:rocket-launch-outline"
            class="w-10 h-10"
          />
        </div>

        <h3 class="text-3xl md:text-4xl font-black text-slate-900 mb-6">
          Cuéntame sobre tu proyecto
        </h3>

        <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed mb-10">
          Desde plataformas web hasta aplicaciones móviles y automatización
          de procesos. Estoy listo para ayudarte a construir algo increíble.
        </p>

        {/* Buttons */}
        <div class="flex flex-col sm:flex-row gap-4 justify-center">

          <a
            href="mailto:enriquegongora45@gmail.com"
            class="btn-primary"
          >
            <Icon
              name="mdi:email-fast-outline"
              class="w-5 h-5"
            />
            Enviar Email

            <Icon
              name="mdi:arrow-right"
              class="w-4 h-4"
            />
          </a>

          <a
            href="https://wa.me/529994231687"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            <Icon
              name="mdi:whatsapp"
              class="w-5 h-5"
            />
            WhatsApp
          </a>

        </div>

      </div>

    </div>

    {/* Response Time */}
    <div class="mt-10 text-center">

      <div class="inline-flex items-center gap-2 px-5 py-3 rounded-full
      bg-white/70 backdrop-blur-xl border border-white/30 shadow-lg shadow-black/5">

        <Icon
          name="mdi:clock-outline"
          class="w-5 h-5 text-emerald-500"
        />

        <p class="text-sm font-medium text-gray-700">
          Tiempo promedio de respuesta:
          <span class="font-bold text-primary-700 ml-1">
            menos de 24 horas
          </span>
        </p>

      </div>

    </div>

  </div>
</section>