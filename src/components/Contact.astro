---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';

const contactInfo = [
  {
    title: 'Email',
    value: 'enriquegongora45',
    href: 'mailto:enriquegongora45@gmail.com',
    icon: 'mdi:email-outline',
    color: 'bg-blue-500',
  },
  {
    title: 'WhatsApp',
    value: '+52 999 423 1687',
    href: 'https://wa.me/529994231687',
    icon: 'mdi:whatsapp',
    color: 'bg-emerald-500',
  },
  {
    title: 'LinkedIn',
    value: 'luisenriquegongoraek',
    href: 'https://www.linkedin.com/in/luisenriquegongoraek',
    icon: 'mdi:linkedin',
    color: 'bg-sky-500',
  },
  {
    title: 'GitHub',
    value: 'legongoraek',
    href: 'https://github.com/legongoraek',
    icon: 'mdi:github',
    color: 'bg-blue-500',
  },
];
---

<section id="contacto" class="section">
  <div class="container-custom">
    <SectionHeader
      anchor="contacto"
      title="¿Trabajamos"
      accent="juntos?"
      lead="Desarrollo soluciones web y móviles enfocadas en rendimiento, escalabilidad y crecimiento digital."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 mb-6">
      {contactInfo.map((item, index) => {
        const external = item.href.startsWith('http');
        return (
          <a
            href={item.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="reveal panel panel-hover group flex items-center gap-4 p-5"
            style={`--reveal-delay:${index * 70}ms`}
          >
            <span class="grid place-items-center w-12 h-12 rounded-xl bg-accent-soft text-accent shrink-0 transition-colors group-hover:bg-accent group-hover:text-on-accent">
              <Icon name={item.icon} class="w-6 h-6" />
            </span>
            <span class="min-w-0">
              <span class="block font-mono text-xs text-muted mb-0.5">{item.title.toLowerCase()}</span>
              <span class="block font-bold text-ink truncate group-hover:text-accent transition-colors">{item.value}</span>
            </span>
          </a>
        );
      })}
    </div>

    {/* Bloque de cierre en azul sólido: el único momento de color pleno de la página. */}
    <div class="reveal relative overflow-hidden rounded-[1.75rem] bg-accent text-on-accent px-6 py-12 md:px-14 md:py-16">
      <div
        class="absolute inset-0 opacity-[0.12] bg-[linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] bg-[size:40px_40px]"
        aria-hidden="true"
      >
      </div>

      <div class="relative grid gap-8 lg:grid-cols-[1.3fr_auto] lg:items-end">
        <div>
          <p class="font-mono text-sm opacity-80 mb-4">respuesta en menos de 24 horas</p>
          <h3 class="text-on-accent text-3xl md:text-5xl font-bold leading-[1.05] mb-4">
            Cuéntame sobre tu proyecto
          </h3>
          <p class="text-base md:text-lg opacity-85 max-w-2xl leading-relaxed">
            Desde plataformas web hasta aplicaciones móviles y automatización de procesos.
            Estoy listo para ayudarte a construir algo increíble.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="mailto:enriquegongora45@gmail.com" class="cta-solid">
            <Icon name="mdi:email-fast-outline" class="w-5 h-5" />
            Enviar email
            <Icon name="mdi:arrow-right" class="btn-arrow w-4 h-4" />
          </a>
          <a href="https://wa.me/529994231687" target="_blank" rel="noopener noreferrer" class="cta-ghost">
            <Icon name="mdi:whatsapp" class="w-5 h-5" />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-solid,
  .cta-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.4rem;
    border-radius: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    transition: transform 200ms ease, background-color 200ms ease;
  }

  .cta-solid {
    background: var(--on-accent);
    color: var(--accent);
  }

  .cta-ghost {
    border: 1px solid color-mix(in srgb, var(--on-accent) 45%, transparent);
  }

  .cta-solid:hover,
  .cta-ghost:hover {
    transform: translateY(-2px);
  }

  .cta-ghost:hover {
    background: color-mix(in srgb, var(--on-accent) 12%, transparent);
  }

  .cta-solid:hover .btn-arrow {
    transform: translateX(3px);
  }
</style>
