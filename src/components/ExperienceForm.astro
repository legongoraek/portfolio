---
// src/components/ExperienceForm.astro
---

<div id="experience-form-container" class="mt-12 p-8 rounded-2xl bg-white/50 backdrop-blur-xl border border-white/30 shadow-lg">
  <h3 class="text-2xl font-bold text-gray-900 mb-6">Agregar Nueva Experiencia</h3>
  
  <form id="experienceForm" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input
        type="text"
        name="role"
        placeholder="Puesto/Rol"
        required
        class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      
      <input
        type="text"
        name="company"
        placeholder="Empresa"
        required
        class="px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <input
      type="text"
      name="period"
      placeholder="Período (ej: Enero 2024 - Actualidad)"
      required
      class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
    />

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Logros (separados por comas)</label>
      <textarea
        name="achievements"
        placeholder="Desarrollo de APIs REST, Diseño de base de datos"
        rows="3"
        required
        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Impacto (separado por comas)</label>
      <textarea
        name="impact"
        placeholder="Mejora en performance, Reducción de errores"
        rows="3"
        required
        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <input
      type="text"
      name="icon"
      placeholder="Icon (ej: mdi:code-braces-box)"
      required
      class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
    />

    <button
      type="submit"
      class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:shadow-lg transition-all duration-300"
    >
      Agregar Experiencia
    </button>
  </form>

  <div id="formMessage" class="mt-4 p-4 rounded-lg hidden"></div>
</div>

<script>
  const form = document.getElementById('experienceForm');
  const messageDiv = document.getElementById('formMessage');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        role: formData.get('role'),
        company: formData.get('company'),
        period: formData.get('period'),
        achievements: formData.get('achievements').split(',').map(a => a.trim()),
        impact: formData.get('impact').split(',').map(i => i.trim()),
        icon: formData.get('icon'),
      };

      try {
        const response = await fetch('/api/experiences', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          messageDiv.textContent = '✅ Experiencia agregada exitosamente';
          messageDiv.className = 'mt-4 p-4 rounded-lg bg-green-100 text-green-700 border border-green-300';
          form.reset();
          
          // Recargar la página después de 2 segundos
          setTimeout(() => window.location.reload(), 2000);
        } else {
          throw new Error('Error al agregar la experiencia');
        }
      } catch (error) {
        messageDiv.textContent = '❌ ' + error.message;
        messageDiv.className = 'mt-4 p-4 rounded-lg bg-red-100 text-red-700 border border-red-300';
      }

      messageDiv.classList.remove('hidden');
    });
  }
</script>
