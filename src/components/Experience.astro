---

import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';

const experiences = [
  {
    "role": "Desarrollador Full Stack Multiplataforma",
    "company": "Freelance",
    "period": "Julio 2025 – Actualidad",
    "current": true,
    "achievements": [
      "Desarrollo de aplicaciones web y móviles nativas para iOS y Android",
      "Construcción de APIs REST con Django REST Framework y autenticación basada en JWT",
      "Apps móviles multiplataforma con React Native y Expo",
      "Diseño de arquitecturas desacopladas frontend/backend orientadas a escalar"
    ],
    "impact": [
      "Base técnica lista para escalar sin reescrituras mayores",
      "Autenticación robusta que protege datos y sesiones de usuario",
      "Experiencia consistente entre web, iOS y Android"
    ],
    "icon": "mdi:laptop-account"
  },
  {
    "role": "Desarrollador Full Stack",
    "company": "Erbessd Instruments",
    "period": "Octubre 2022 – Enero 2026",
    "current": false,
    "achievements": [
      "Diseño y optimización de endpoints backend de alto rendimiento",
      "Desarrollo de interfaces con Vue.js, Electron, HTML y CSS",
      "Administración y mantenimiento de bases de datos SQL en producción",
      "Creación de una librería de componentes reutilizables para todo el equipo"
    ],
    "impact": [
      "Comunicación frontend-backend más rápida y confiable",
      "Menos bugs gracias a componentes probados y reutilizables",
      "Sistema más fácil de mantener y extender por el equipo"
    ],
    "icon": "mdi:code-braces-box"
  },
  {
    "role": "Desarrollo Web, Integraciones y Automatización",
    "company": "Freelance",
    "period": "Enero 2022 – Actualidad",
    "current": true,
    "achievements": [
      "Desarrollo y administración de tiendas con WordPress y WooCommerce",
      "Middlewares a medida con Node.js para conectar sistemas",
      "Integración de APIs externas de pago, envíos y CRMs",
      "Automatización de flujos de negocio para eliminar trabajo manual"
    ],
    "impact": [
      "Horas de trabajo manual convertidas en procesos automáticos",
      "Sincronización de datos más rápida entre sistemas",
      "Menos errores humanos en procesos operativos clave"
    ],
    "icon": "mdi:cog-sync"
  }
]
---

<section id="experiencia" class="section">
  <div class="container-custom">
    <SectionHeader
      anchor="experiencia"
      title="Trayectoria"
      accent="profesional"
      lead="Más de 3 años construyendo plataformas web, móviles y sistemas escalables enfocados en negocio."
    />

    {/* Riel de fechas a la izquierda, tarjeta a la derecha: el orden cronológico se lee de arriba abajo. */}
    <ol class="relative space-y-6 md:space-y-8">
      {experiences.map((exp, index) => (
        <li class="reveal group relative grid gap-4 lg:grid-cols-[14rem_1fr] lg:gap-12 pl-8 lg:pl-0" style={`--reveal-delay:${index * 90}ms`}>
          {/* Línea y punto: en móvil a la izquierda, en desktop entre riel y tarjeta. */}
          <span class="absolute left-[7px] lg:left-[calc(14rem+1.5rem)] top-3 bottom-[-2rem] w-px bg-line group-last:hidden" aria-hidden="true"></span>
          <span
            class:list={[
              'absolute left-0 lg:left-[calc(14rem+1.5rem-7.5px)] top-2 w-4 h-4 rounded-full border-[3px] border-canvas',
              exp.current ? 'bg-ok' : 'bg-accent',
            ]}
            aria-hidden="true"
          ></span>

          <div class="lg:text-right lg:pt-0.5">
            <p class="font-mono text-sm text-accent">{exp.period}</p>
            <p class="mt-1 font-semibold text-ink inline-flex items-center gap-2 lg:justify-end">
              {exp.company}
              {exp.current && (
                <span class="inline-flex items-center gap-1 rounded-full bg-ok/12 text-ok text-[0.7rem] font-bold px-2 py-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-ok"></span>
                  Actual
                </span>
              )}
            </p>
          </div>

          <article class="panel panel-hover p-6 md:p-8">
            <div class="flex items-start justify-between gap-5 mb-6">
              <h3 class="text-xl md:text-2xl font-bold leading-tight">{exp.role}</h3>
              <span class="grid place-items-center w-12 h-12 rounded-xl bg-accent-soft text-accent shrink-0">
                <Icon name={exp.icon} class="w-6 h-6" />
              </span>
            </div>

            <div class="grid gap-6 md:grid-cols-2 md:gap-8">
              <div>
                <p class="eyebrow mb-3">responsabilidades</p>
                <ul class="space-y-2.5">
                  {exp.achievements.map((achievement) => (
                    <li class="flex items-start gap-2.5 text-[0.95rem] text-ink/85 leading-relaxed">
                      <span class="mt-[0.6rem] w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-xl bg-surface-2 border border-line p-5">
                <p class="eyebrow mb-3">impacto</p>
                <ul class="space-y-2.5">
                  {exp.impact.map((item) => (
                    <li class="flex items-start gap-2.5 text-[0.95rem] text-ink/85 leading-relaxed">
                      <Icon name="mdi:check" class="w-4 h-4 mt-1 text-ok shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
