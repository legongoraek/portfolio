---
// Widget de chat flotante. Habla con el servicio compartido
// portfolio-assistant (https://github.com/legongoraek/portfolio-assistant)
// sobre la experiencia, proyectos y stack de Luis Enrique.
---

<div id="chatbot-root">
  <button
    id="chatbot-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="chatbot-panel"
    aria-label="Abrir chat"
  >
    <svg id="chatbot-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <svg id="chatbot-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>

  <div id="chatbot-panel" role="dialog" aria-modal="false" aria-label="Chat sobre Luis Enrique" hidden>
    <div id="chatbot-header">
      <div>
        <strong>Pregúntame sobre mi trabajo</strong>
        <span>Respuestas generadas con IA sobre mi experiencia y proyectos</span>
      </div>
    </div>

    <div id="chatbot-messages" aria-live="polite"></div>

    <form id="chatbot-form" autocomplete="off">
      <input
        id="chatbot-input"
        type="text"
        name="message"
        maxlength="500"
        placeholder="Ej: ¿Qué experiencia tiene con Django?"
        aria-label="Escribe tu pregunta"
      />
      <button type="submit" aria-label="Enviar">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m22 2-7 20-4-9-9-4Z"></path>
          <path d="M22 2 11 13"></path>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  #chatbot-root {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
  }

  #chatbot-toggle {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #3156d3;
    color: white;
    border: none;
    cursor: pointer;
    box-shadow: 0 12px 30px rgba(49, 86, 211, 0.35);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  #chatbot-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(49, 86, 211, 0.4);
  }

  #chatbot-toggle svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  #chatbot-panel[hidden] {
    display: none;
  }

  #chatbot-panel {
    position: fixed;
    right: 1rem;
    bottom: 5.5rem;
    width: min(22rem, calc(100vw - 2rem));
    height: min(30rem, calc(100vh - 6.5rem));
    height: min(30rem, calc(100dvh - 6.5rem));
    max-height: calc(100dvh - 6.5rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(49, 87, 213, 0.15);
    box-shadow: 0 24px 60px rgba(31, 50, 95, 0.25);
  }

  :global(.dark) #chatbot-panel {
    background: rgb(15, 23, 42);
    border-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 480px) {
    #chatbot-panel {
      right: 0.75rem;
      bottom: 5rem;
      width: calc(100vw - 1.5rem);
      height: min(30rem, calc(100dvh - 6rem));
      max-height: calc(100dvh - 6rem);
      border-radius: 1rem;
    }
  }

  #chatbot-header {
    padding: 1rem 1.1rem;
    background: #3156d3;
    color: white;
  }

  #chatbot-header strong {
    display: block;
    font-size: 0.95rem;
  }

  #chatbot-header span {
    display: block;
    font-size: 0.75rem;
    opacity: 0.85;
    margin-top: 0.15rem;
  }

  #chatbot-messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.88rem;
  }

  :global(.chatbot-msg) {
    max-width: 85%;
    padding: 0.55rem 0.8rem;
    border-radius: 0.9rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.chatbot-msg.user) {
    align-self: flex-end;
    background: #3156d3;
    color: white;
    border-bottom-right-radius: 0.25rem;
  }

  :global(.chatbot-msg.assistant) {
    align-self: flex-start;
    background: rgba(49, 87, 213, 0.09);
    color: #14213d;
    border-bottom-left-radius: 0.25rem;
  }

  :global(.dark .chatbot-msg.assistant) {
    background: rgba(255, 255, 255, 0.08);
    color: rgb(243, 244, 246);
  }

  :global(.chatbot-msg.error) {
    align-self: center;
    background: rgba(220, 38, 38, 0.1);
    color: #b91c1c;
    font-size: 0.8rem;
  }

  #chatbot-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid rgba(49, 87, 213, 0.12);
  }

  :global(.dark) #chatbot-form {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  #chatbot-input {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.85rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(49, 87, 213, 0.2);
    background: transparent;
    color: inherit;
    font-size: 0.88rem;
  }

  #chatbot-input:focus {
    outline: none;
    border-color: #3156d3;
  }

  #chatbot-form button[type='submit'] {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.8rem;
    border: none;
    background: #3156d3;
    color: white;
    cursor: pointer;
    flex-shrink: 0;
  }

  #chatbot-form button[type='submit']:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  #chatbot-form button[type='submit'] svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>

<script>
  type ChatMessage = { role: 'user' | 'assistant'; content: string };

  // Servicio compartido: github.com/legongoraek/portfolio-assistant.
  // Actualiza esta URL si el proyecto se despliega con otro dominio en Vercel.
  const CHAT_API_URL = 'https://portfolio-assistant-six.vercel.app/api/chat';

  const root = document.getElementById('chatbot-root');
  const toggle = document.getElementById('chatbot-toggle');
  const panel = document.getElementById('chatbot-panel');
  const iconOpen = document.getElementById('chatbot-icon-open');
  const iconClose = document.getElementById('chatbot-icon-close');
  const messagesEl = document.getElementById('chatbot-messages');
  const form = document.getElementById('chatbot-form') as HTMLFormElement | null;
  const input = document.getElementById('chatbot-input') as HTMLInputElement | null;

  if (root && toggle && panel && messagesEl && form && input) {
    const history: ChatMessage[] = [];
    let isOpen = false;
    let isSending = false;
    let greetingShown = false;

    function setOpen(next: boolean) {
      isOpen = next;
      panel!.hidden = !isOpen;
      toggle!.setAttribute('aria-expanded', String(isOpen));
      if (iconOpen && iconClose) {
        iconOpen.style.display = isOpen ? 'none' : '';
        iconClose.style.display = isOpen ? '' : 'none';
      }
      if (isOpen) {
        input!.focus();
        if (!greetingShown) {
          appendMessage(
            'assistant',
            'Hola 👋 Soy el asistente de este portafolio. Pregúntame sobre la experiencia, proyectos o stack técnico de Luis Enrique.'
          );
          greetingShown = true;
        }
      }
    }

    function appendMessage(role: 'user' | 'assistant' | 'error', content: string) {
      const bubble = document.createElement('div');
      bubble.className = `chatbot-msg ${role}`;
      bubble.textContent = content;
      messagesEl!.appendChild(bubble);
      messagesEl!.scrollTop = messagesEl!.scrollHeight;
    }

    toggle.addEventListener('click', () => setOpen(!isOpen));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const text = input!.value.trim();
      if (!text || isSending) return;

      appendMessage('user', text);
      history.push({ role: 'user', content: text });
      input!.value = '';
      isSending = true;
      const submitBtn = form!.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch(CHAT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        const data = await res.json();

        if (!res.ok) {
          appendMessage('error', data.error || 'Ocurrió un error, intenta de nuevo.');
          history.pop();
          return;
        }

        appendMessage('assistant', data.reply || '...');
        history.push({ role: 'assistant', content: data.reply || '' });
      } catch {
        appendMessage('error', 'No se pudo conectar con el chat. Intenta de nuevo.');
        history.pop();
      } finally {
        isSending = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
