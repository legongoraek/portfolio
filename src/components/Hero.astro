---
---

<header
  class="relative overflow-hidden pt-2 md:pt-32 pb-0 md:pb-24 isolate bg-white"
>
<section id="sobre-mi" class="py-16 md:py-24 bg-white">

  {/* Glow Effects */}
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-400/20 rounded-full blur-3xl opacity-30 -z-10"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-300/20 rounded-full blur-3xl opacity-30 -z-10"></div>
  
  {/* Grid Pattern */}
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#64748b_1px,transparent_1px),linear-gradient(to_bottom,#64748b_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  </div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
  
      {/* LEFT CONTENT */}
      <div class="relative z-10">
  
        {/* Badge */}
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6 md:mb-8
        bg-white/70 dark:bg-slate-900/70
        border border-white/20 dark:border-white/10
        backdrop-blur-xl shadow-lg shadow-black/5">
  
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
  
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
            Disponible para proyectos freelance
          </span>
        </div>
  
        {/* Intro */}
        <p class="text-primary-600 dark:text-primary-400 font-semibold tracking-wide uppercase mb-4">
          Full Stack Developer
        </p>
  
        {/* Title */}
        <h1 class="text-5xl md:text-6xl font-black tracking-tight leading-[1.2] mb-6">
  
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-400">
            Luis Enrique
          </span>
  
          <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-400">
            Góngora Ek
          </span>
  
        </h1>
  
        {/* Subtitle */}
        <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-xl mb-6 md:mb-10">
          Construyo experiencias web y mobile modernas,
          escalables y enfocadas en negocio.
        </p>
  
        {/* Description */}
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-xl mb-6 md:mb-10">
          Especializado en Django, React, React Native y arquitecturas modernas.
          Desarrollo productos digitales optimizados para rendimiento,
          escalabilidad y crecimiento.
        </p>
  
        {/* CTA */}
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-8 md:mb-14">
  
          <a href="#contacto" class="btn-primary">
            Contacta conmigo
            <span>→</span>
          </a>
  
          <a href="#proyectos" class="btn-secondary">
            Ver proyectos
          </a>
  
        </div>
  
        {/* STATS */}
        <div class="grid grid-cols-3 gap-4">
  
          <div class="stats-card">
            <p class="stats-number">4+</p>
            <p class="stats-label">Años experiencia</p>
          </div>
  
          <div class="stats-card">
            <p class="stats-number">12+</p>
            <p class="stats-label">Proyectos</p>
          </div>
  
          <div class="stats-card">
            <p class="stats-number">99%</p>
            <p class="stats-label">Satisfacción</p>
          </div>
  
        </div>
  
      </div>
  
      {/* RIGHT SIDE */}
      <div class="relative hidden lg:flex justify-center">
  
        {/* Background Card */}
        <div class="absolute inset-0 bg-gradient-to-tr from-primary-600/20 to-blue-400/10 rounded-[2.5rem] blur-3xl scale-110"></div>
  
        {/* Floating Elements */}
        <div class="absolute -top-8 -left-8 glass-card px-5 py-4 animate-float">
          <p class="text-sm font-semibold text-primary-600 dark:text-primary-400">
            Django REST
          </p>
        </div>
  
        <div class="absolute bottom-10 -right-10 glass-card px-5 py-4 animate-float-delay">
          <p class="text-sm font-semibold text-primary-600 dark:text-primary-400">
            React Native
          </p>
        </div>
  
        {/* Image Container */}
        <div class="relative">
  
          {/* Glow */}
          <div class="absolute inset-0 bg-gradient-to-r from-primary-600 to-blue-500 rounded-[2rem] blur-2xl opacity-20"></div>
  
          {/* Image */}
          <img
            src="https://legongoraek.github.io/assets/img/IMG_9656.PNG"
            alt="Luis Enrique Góngora Ek"
            class="relative z-10 w-full max-w-lg rounded-[2rem]
            border border-white/20
            shadow-[0_30px_80px_rgba(0,0,0,0.25)]
            object-cover"
          />
  
        </div>
  
      </div>
  
    </div>
  
  </div>
</section>

</header>

<style>
  .glass-card {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(14px);

    border: 1px solid rgba(255,255,255,0.2);

    border-radius: 1rem;

    box-shadow:
      0 10px 30px rgba(0,0,0,0.08);
  }

  .dark .glass-card {
    background: rgba(15,23,42,0.7);

    border-color: rgba(255,255,255,0.08);
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delay {
    animation: float 6s ease-in-out infinite;
    animation-delay: 2s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }

    50% {
      transform: translateY(-10px);
    }
  }
</style>
