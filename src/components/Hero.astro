---
import { Icon } from 'astro-icon/components';

const stats = [
  { value: '4+', label: 'años de experiencia' },
  { value: '12+', label: 'proyectos entregados' },
  { value: '99%', label: 'satisfacción' },
];
---

<header id="sobre-mi" class="relative isolate overflow-hidden pt-32 pb-16 md:pt-40 md:pb-28">
  {/* Cuadrícula tenue: solo en el hero, como papel milimétrico. */}
  <div
    class="absolute inset-0 -z-10 opacity-[0.5] dark:opacity-[0.35] bg-[linear-gradient(to_right,var(--line)_1px,transparent_1px),linear-gradient(to_bottom,var(--line)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-custom grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] gap-14 lg:gap-16 items-center">
    <div>
      <div class="hero-in inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line bg-surface text-sm font-semibold text-muted mb-8">
        <span class="relative flex w-2 h-2">
          <span class="absolute inset-0 rounded-full bg-ok animate-ping opacity-60"></span>
          <span class="relative w-2 h-2 rounded-full bg-ok"></span>
        </span>
        Disponible para proyectos freelance
      </div>

      <p class="hero-in eyebrow mb-4" style="--d:80ms">Full Stack Developer · Web, mobile y automatización</p>

      <h1 class="hero-in text-[2.9rem] sm:text-6xl lg:text-7xl font-bold leading-[0.98] tracking-[-0.035em] mb-7" style="--d:140ms">
        Luis Enrique
        <span class="block text-accent">Góngora Ek</span>
      </h1>

      <p class="hero-in text-lg md:text-xl text-ink/85 leading-relaxed max-w-xl mb-4" style="--d:200ms">
        Construyo experiencias web y mobile modernas, escalables y enfocadas en negocio.
      </p>

      <p class="hero-in text-muted leading-relaxed max-w-xl mb-9" style="--d:240ms">
        Especializado en Django, React, React Native y arquitecturas modernas. Desarrollo productos
        digitales optimizados para rendimiento, escalabilidad y crecimiento.
      </p>

      <div class="hero-in flex flex-col sm:flex-row gap-3 mb-12" style="--d:300ms">
        <a href="#contacto" class="btn-primary">
          Contacta conmigo
          <Icon name="mdi:arrow-right" class="btn-arrow w-4 h-4" />
        </a>
        <a href="#proyectos" class="btn-secondary">Ver proyectos</a>
      </div>

      <dl class="hero-in grid grid-cols-3 max-w-lg border-t border-line pt-6" style="--d:360ms">
        {stats.map((stat, i) => (
          <div class:list={['flex flex-col-reverse justify-end pr-3', i > 0 && 'pl-4 border-l border-line']}>
            <dt class="mt-1 text-xs md:text-sm text-muted leading-snug">{stat.label}</dt>
            <dd class="font-display text-3xl md:text-4xl font-bold text-ink">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    {/* Avatar sobre un bloque azul desplazado: la firma visual del sitio. */}
    <div class="hero-in relative mx-auto w-full max-w-[22rem] sm:max-w-md lg:max-w-none lg:pl-8" style="--d:200ms">
      <div class="relative">
        <div class="absolute inset-0 translate-x-4 translate-y-4 md:translate-x-6 md:translate-y-6 rounded-[2rem] bg-accent" aria-hidden="true"></div>
        <img
          src="https://legongoraek.github.io/assets/img/IMG_9656.PNG"
          fetchpriority="high"
          decoding="async"
          width="560"
          height="560"
          alt="Ilustración de Luis Enrique Góngora Ek"
          class="relative w-full aspect-square rounded-[2rem] border border-line object-cover bg-surface"
        />
      </div>
    </div>
  </div>
</header>

<style>
  /* Secuencia de entrada escalonada al cargar. */
  .hero-in {
    animation: hero-in 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
